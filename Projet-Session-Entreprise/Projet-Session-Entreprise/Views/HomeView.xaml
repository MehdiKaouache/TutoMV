<UserControl x:Class="Projet_Session_Entreprise.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <Grid Margin="40">
        <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Bienvenue sur TutoMV" FontSize="48" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryMauve}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="La plateforme d'excellence pour la réussite scolaire au Cégep." FontSize="18" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,0,0,50"/>

            <Grid MaxWidth="900" Margin="0,0,0,50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#111122" CornerRadius="12" Padding="25" BorderBrush="#2A2A4A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Cherchez" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Trouvez le tuteur idéal selon vos matières et vos disponibilités." Foreground="{StaticResource SubText}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#111122" CornerRadius="12" Padding="25" BorderBrush="#2A2A4A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Réservez" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Planifiez une rencontre en ligne ou en personne en quelques clics." Foreground="{StaticResource SubText}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#111122" CornerRadius="12" Padding="25" BorderBrush="#2A2A4A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🎓" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Réussissez" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Améliorez vos notes et atteignez vos objectifs académiques." Foreground="{StaticResource SubText}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Content="Créer mon compte maintenant" Style="{StaticResource PrimaryButtonStyle}" Height="60" Width="300" FontSize="18" Command="{Binding RegisterGuestCommand}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding StudentName, StringFormat='Bonjour, {0} 👋'}" FontSize="36" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Text="Voici un résumé de votre progression." Foreground="{StaticResource SubText}" FontSize="16" Margin="0,0,0,30"/>

            <Border Background="#161625" BorderBrush="#7B61FF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,30" Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding NotificationText}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Séances suivies" Foreground="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding StudentTotalSeances}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Heures complétées" Foreground="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding StudentHeures}" FontSize="32" FontWeight="Bold" Foreground="#00E676" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Moyenne Générale" Foreground="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding StudentMoyenne}" FontSize="32" FontWeight="Bold" Foreground="#FBC531" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Prochaines séances" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
            <ListBox ItemsSource="{Binding UpcomingAppointments}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tutor.Prenom, StringFormat='Avec {0}'}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                    <TextBlock Text="{Binding DateRDV, StringFormat={}{0:dd MMMM yyyy à HH:mm}}" Foreground="{StaticResource SubText}" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Trouver un nouveau tuteur" Style="{StaticResource ActionButton}" Width="250" Height="45" HorizontalAlignment="Left" Margin="0,20,0,0" Command="{Binding ExploreCommand}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsTutor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding TutorName, StringFormat='Espace Tuteur de {0} 📚'}" FontSize="36" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Text="Gérez vos élèves et vos disponibilités." Foreground="{StaticResource SubText}" FontSize="16" Margin="0,0,0,30"/>

            <Border Background="#161625" BorderBrush="#7B61FF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,30" Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding NotificationText}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Élèves aidés" Foreground="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding TutorEtudiants}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Heures données" Foreground="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding TutorHeures}" FontSize="32" FontWeight="Bold" Foreground="#00E676" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Note globale" Foreground="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding TutorNote}" FontSize="32" FontWeight="Bold" Foreground="#FBC531" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Demandes en attente" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
            <ListBox ItemsSource="{Binding PendingRequestsList}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Student.Prenom, StringFormat='Demande de {0}'}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                    <TextBlock Text="{Binding DateRDV, StringFormat={}{0:dd MMMM yyyy à HH:mm}}" Foreground="{StaticResource SubText}" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Gérer mes demandes" Style="{StaticResource ActionButton}" Width="250" Height="45" HorizontalAlignment="Left" Margin="0,20,0,0" Command="{Binding ManageRequestsCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>