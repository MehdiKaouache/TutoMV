<UserControl x:Class="Projet_Session_Entreprise.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Padding="15,10" Margin="0,0,0,25" HorizontalAlignment="Left" MinWidth="400" Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A1A2E"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryMauve}"/>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔔" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock Text="{Binding NotificationText}" Foreground="White" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <StackPanel x:Name="GuestPanel" Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Bienvenue sur TutoMV" FontSize="42" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,10"/>
                <TextBlock Text="La plateforme de tutorat n°1 pour réussir vos examens." FontSize="18" Foreground="{StaticResource SubText}" Margin="0,0,0,40"/>
                <Border Style="{StaticResource CardStyle}" Padding="40" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Pourquoi choisir TutoMV ?" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                        <TextBlock Text="• Tuteurs certifiés par l'école" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock Text="• Réservation simple et rapide" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                        <Button Content="Créer un compte maintenant" Style="{StaticResource ActionButton}" Width="250" HorizontalAlignment="Left" Command="{Binding RegisterGuestCommand}" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="StudentPanel" Visibility="{Binding IsStudent, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Tableau de bord - Étudiant" FontSize="32" FontWeight="Bold" Foreground="{StaticResource MainText}"/>
                <UniformGrid Columns="3" Margin="0,20,0,30">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Séances suivies" Foreground="{StaticResource SubText}" FontSize="12"/>
                            <TextBlock Text="{Binding StudentTotalSeances}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Heures complétées" Foreground="{StaticResource SubText}" FontSize="12"/>
                            <TextBlock Text="{Binding StudentHeures}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Moyenne" Foreground="{StaticResource SubText}" FontSize="12"/>
                            <TextBlock Text="{Binding StudentMoyenne}" FontSize="28" FontWeight="Bold" Foreground="#FBC531" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Background="{StaticResource PrimaryMauve}" CornerRadius="15" Padding="35">
                    <StackPanel>
                        <TextBlock Text="Prêt pour votre prochaine réussite ?" FontSize="22" FontWeight="Bold" Foreground="#000000"/>
                        <Button Content="Explorer les tuteurs" Width="200" HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Background="Black" Foreground="White" Command="{Binding ExploreCommand}" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="TutorPanel" Visibility="{Binding IsTutor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Tableau de bord - Tuteur" FontSize="32" FontWeight="Bold" Foreground="{StaticResource MainText}"/>
                <UniformGrid Columns="3" Margin="0,20,0,30">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Étudiants aidés" Foreground="{StaticResource SubText}" FontSize="12"/>
                            <TextBlock Text="{Binding TutorEtudiants}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Heures de tutorat" Foreground="{StaticResource SubText}" FontSize="12"/>
                            <TextBlock Text="{Binding TutorHeures}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Note" Foreground="{StaticResource SubText}" FontSize="12"/>
                            <TextBlock Text="{Binding TutorNote}" FontSize="28" FontWeight="Bold" Foreground="#FBC531" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource PrimaryMauve}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Gérer mes disponibilités et demandes" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Content="Gérer mes séances" Style="{StaticResource ActionButton}" Width="200" HorizontalAlignment="Left" Margin="0,20,0,0" Command="{Binding ManageRequestsCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>