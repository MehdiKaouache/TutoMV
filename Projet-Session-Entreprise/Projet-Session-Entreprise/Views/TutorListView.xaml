<UserControl x:Class="Projet_Session_Entreprise.UI.Views.TutorListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Trouver un tuteur" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryMauve}"/>
            <Border Height="3" Background="{StaticResource PrimaryMauve}" Width="60" HorizontalAlignment="Left" Margin="2,5,0,0"/>
            <TextBlock Text="Filtrez et trouvez l'expert idéal pour votre réussite." Foreground="{StaticResource SubText}" FontSize="14" Margin="0,10,0,20"/>

            <Border Background="#1A1A2E" CornerRadius="10" Padding="20" BorderBrush="#2A2A4A" BorderThickness="1" MaxWidth="1100" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Recherche textuelle" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Background="#0A0A15" Foreground="White" BorderBrush="#3A3A5A" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                                 Tag="Nom ou prénom..."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Matière" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Subjects}" 
                                  SelectedItem="{Binding SelectedSubject}" 
                                  Height="40" VerticalContentAlignment="Center" FontSize="14"
                                  Background="#0A0A15" Foreground="White" BorderBrush="#3A3A5A" BorderThickness="1">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#0A0A15"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryMauve}"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Évaluation minimale" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Ratings}" 
                                  SelectedItem="{Binding SelectedRating}" 
                                  Height="40" VerticalContentAlignment="Center" FontSize="14" FontWeight="Bold"
                                  Background="#0A0A15" Foreground="#FBC531" BorderBrush="#3A3A5A" BorderThickness="1">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#0A0A15"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryMauve}"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Rechercher" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding ApplyFiltersCommand}" Width="120" Height="40" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="🔍 Aucun tuteur ne correspond à vos critères." 
                   Foreground="{StaticResource SubText}" FontSize="16" FontStyle="Italic" 
                   HorizontalAlignment="Left" Margin="20,20,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Results.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" 
                 ItemContainerStyle="{StaticResource CleanListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListCardStyle}" MaxWidth="1100" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Prenom}" FontWeight="Bold" FontSize="20" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Nom}" FontWeight="Bold" FontSize="20" Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#252545" CornerRadius="5" Padding="8,4" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding Subject, TargetNullValue='Général'}" Foreground="{StaticResource PrimaryMauve}" FontSize="13" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="⭐" Foreground="#FBC531" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                                    <TextBlock Text="{Binding AverageRating, StringFormat='{}{0:0.0} / 5'}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock Text="{Binding NumberOfRatings, StringFormat='{} ({0} avis)'}" Foreground="{StaticResource SubText}" VerticalAlignment="Center" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Voir disponibilités" Style="{StaticResource ActionButton}" Width="160" Height="40" 
                                        Command="{Binding DataContext.NavigateToBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>