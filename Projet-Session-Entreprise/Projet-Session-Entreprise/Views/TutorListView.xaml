<UserControl x:Class="Projet_Session_Entreprise.UI.Views.TutorListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Trouver un tuteur" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryMauve}"/>
            <Border Height="3" Background="{StaticResource PrimaryMauve}" Width="60" HorizontalAlignment="Left" Margin="2,5,0,0"/>
            <TextBlock Text="Parcourez la liste des experts disponibles." Foreground="{StaticResource SubText}" FontSize="14" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="400" Style="{StaticResource ModernTextBoxStyle}" 
                         Tag="Rechercher par nom ou matière..."/>

                <Button Content="Rechercher" Width="130" Margin="15,0,0,0" 
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RechercherCommand}"/>
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" 
                 ItemContainerStyle="{StaticResource CleanListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListCardStyle}" MaxWidth="800" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Prenom}" FontWeight="Bold" FontSize="20" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Nom}" FontWeight="Bold" FontSize="20" Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Spécialité :" Foreground="{StaticResource SubText}" Margin="0,0,5,0" FontSize="13"/>
                                    <TextBlock Text="{Binding Subject, TargetNullValue='Non spécifiée'}" Foreground="White" Margin="0,0,20,0" FontSize="13"/>

                                    <TextBlock Text="Note moyenne :" Foreground="{StaticResource SubText}" Margin="0,0,5,0" FontSize="13"/>
                                    <TextBlock Text="{Binding AverageRating, StringFormat='{}{0:0.0} / 5'}" Foreground="#FBC531" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Voir dispo" Style="{StaticResource ActionButton}" Width="120" Height="40" 
                                        Command="{Binding DataContext.NavigateToBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>