<UserControl x:Class="Projet_Session_Entreprise.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Mes Rendez-vous" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryMauve}"/>
            <Border Height="3" Background="{StaticResource PrimaryMauve}" Width="60" HorizontalAlignment="Left" Margin="2,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,20,0">
                <DataGrid x:Name="dgAppointments" ItemsSource="{Binding MyAppointments}" SelectedItem="{Binding SelectedAppointment}" 
                          AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateRDV, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/>
                        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100"/>

                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.TutorSectionVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Button Content="✓" Command="{Binding DataContext.AcceptAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Background="Green" Foreground="White" Width="30" Margin="0,0,5,0"/>
                                        <Button Content="✕" Command="{Binding DataContext.RefuseAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Background="Red" Foreground="White" Width="30"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Column="1" Visibility="{Binding DetailsVisibility}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Détails du rendez-vous" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,15"/>

                        <TextBlock Text="Date et Heure" Foreground="{StaticResource SubText}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedAppointment.DateRDV, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="16" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="Durée estimée" Foreground="{StaticResource SubText}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedAppointment.Duree, TargetNullValue='Non spécifiée'}" FontSize="16" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="Lieu / Lien visio" Foreground="{StaticResource SubText}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedAppointment.Lieu, TargetNullValue='Non spécifié'}" FontSize="16" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{Binding ReviewSectionVisibility}">
                    <StackPanel>
                        <TextBlock Text="Noter la séance" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Note (/5) :" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding Rating}" Width="40" Background="#3D3D3D" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                        <TextBlock Text="Commentaire :" Foreground="White" Margin="0,5"/>
                        <TextBox Text="{Binding Comment}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="#3D3D3D" Foreground="White" BorderThickness="0"/>
                        <Button Content="Envoyer l'avis" Command="{Binding AddReviewCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="LightGreen" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>