<UserControl x:Class="Projet_Session_Entreprise.UI.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <Grid>
        <Border Style="{StaticResource CardStyle}" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
            <StackPanel>
                <TextBlock x:Name="txtTutorName" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Sélectionnez un créneau disponible" Foreground="{StaticResource SubText}" TextAlignment="Center" Margin="0,0,0,25"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                    <ItemsControl x:Name="icSlots">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Slot_Click" Margin="8" Padding="15" Background="#1A1A1A" BorderBrush="{StaticResource PrimaryMauve}" BorderThickness="1" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2A2A2A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Day}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" Foreground="{StaticResource PrimaryMauve}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Content="Annuler la réservation" Style="{StaticResource LinkButton}" Margin="0,20,0,0" Click="BtnCancel_Click" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ModalOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                    CornerRadius="15" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                <StackPanel>
                    <TextBlock x:Name="txtModalTitle" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,20"/>
                    <TextBlock x:Name="txtModalMessage" Foreground="White" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,30"/>

                    <StackPanel x:Name="ModalActionButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Annuler" Click="ModalCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Confirmer" Click="ModalConfirm_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                    </StackPanel>

                    <StackPanel x:Name="ModalOkButton" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="OK" Click="ModalOk_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>