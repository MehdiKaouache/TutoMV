<UserControl x:Class="Projet_Session_Entreprise.UI.Views.ReceivedRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainBG}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Demandes reçues" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryMauve}"/>
                <Border Height="3" Background="{StaticResource PrimaryMauve}" Width="60" HorizontalAlignment="Left" Margin="2,5,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessGreen}" FontSize="14" Margin="0,15,0,0" FontWeight="Bold"/>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Appointments}" Background="Transparent" BorderThickness="0" 
                     ItemContainerStyle="{StaticResource CleanListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListCardStyle}" MaxWidth="800" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                                    <TextBlock Text="{Binding DateRDV, StringFormat={}{0:dd MMMM yyyy à HH:mm}}" FontWeight="Bold" FontSize="18" Foreground="White" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Durée :" Foreground="{StaticResource SubText}" Margin="0,0,5,0" FontSize="13"/>
                                        <TextBlock Text="{Binding Duree, TargetNullValue='Non spécifiée'}" Foreground="White" Margin="0,0,20,0" FontSize="13"/>
                                        <TextBlock Text="Lieu :" Foreground="{StaticResource SubText}" Margin="0,0,5,0" FontSize="13"/>
                                        <TextBlock Text="{Binding Lieu, TargetNullValue='Non spécifié'}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="En attente">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="Accepter" Style="{StaticResource SuccessButton}" Width="110" Height="40" Margin="0,0,10,0" 
                                            Command="{Binding DataContext.PromptAcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Refuser" Style="{StaticResource DangerButton}" Width="110" Height="40" 
                                            Command="{Binding DataContext.PromptRefuseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"/>
                                </StackPanel>

                                <Border Grid.Column="1" CornerRadius="5" Padding="15,8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Accepté">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#1A4A25"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Refusé">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#4A1A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Background="#CC000000" Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                    CornerRadius="15" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                <StackPanel>
                    <TextBlock Text="Confirmation requise" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding ModalMessage}" Foreground="White" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,30"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CancelActionCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Confirmer" Command="{Binding ConfirmActionCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>