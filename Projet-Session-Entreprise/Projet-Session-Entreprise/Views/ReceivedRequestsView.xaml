<Window x:Class="Projet_Session_Entreprise.Views.ReceivedRequestsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demandes reçues"
        Height="400"
        Width="500"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Demandes reçues"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Appointments}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding DateRDV}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Status}"
                                   Foreground="Gray"
                                   Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Accepter"
                                    Command="{Binding DataContext.AccepterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Width="80"
                                    Margin="0,5,5,0"/>

                            <Button Content="Refuser"
                                    Command="{Binding DataContext.RefuserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Width="80"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
