        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Projet_Session_Entreprise.ViewModels"
        Title="Profil"
        Height="850"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding DA, StringFormat='Profil : {0}'}"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Bienvenue, " FontSize="18"/>
                <TextBlock Text="{Binding Prenom}"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="5,0,0,0"/>
                <TextBlock Text="{Binding Nom}"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- COLONNE GAUCHE -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,15,0">

                <StackPanel>

                    <!-- RENDEZ-VOUS -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="Mes rendez-vous"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="#273C75"/>

                            <DataGrid ItemsSource="{Binding MyAppointments}"
                                      SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="230">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id"
                                                        Binding="{Binding Id}"
                                                        Width="45"/>

                                    <DataGridTextColumn Header="StudentId"
                                                        Binding="{Binding StudentId}"
                                                        Width="80"/>

                                    <DataGridTextColumn Header="TutorId"
                                                        Binding="{Binding TutorId}"
                                                        Width="80"/>

                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding DateRDV, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Statut"
                                                        Binding="{Binding Status}"
                                                        Width="100"/>

                                    <!-- ACTIONS TUTEUR : ACCEPTER / REFUSER -->
                                    <DataGridTemplateColumn Header="Actions"
                                                            Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding DataContext.TutorSectionVisibility, RelativeSource={RelativeSource AncestorType=DataGrid}}">

                                                    <Button Content="Accepter"
                                                            Command="{Binding DataContext.AcceptAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Width="85"
                                                            Height="28"
                                                            Margin="0,0,5,0"
                                                            Background="#27AE60"
                                                            Foreground="White"
                                                            FontWeight="Bold"/>

                                                    <Button Content="Refuser"
                                                            Command="{Binding DataContext.RefuseAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Width="85"
                                                            Height="28"
                                                            Background="#E74C3C"
                                                            Foreground="White"
                                                            FontWeight="Bold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Marquer la séance sélectionnée comme terminée"
                                    Command="{Binding CompleteAppointmentCommand}"
                                    Height="38"
                                    Background="#27AE60"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding TutorSectionVisibility}"/>
                        </StackPanel>
                    </Border>

                    <!-- SÉANCES TERMINÉES -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="Séances terminées"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="#273C75"/>

                            <DataGrid ItemsSource="{Binding CompletedAppointments}"
                                      SelectedItem="{Binding SelectedCompletedAppointment, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="180">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id"
                                                        Binding="{Binding Id}"
                                                        Width="50"/>

                                    <DataGridTextColumn Header="AppointmentId"
                                                        Binding="{Binding AppointmentId}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="StudentId"
                                                        Binding="{Binding StudentId}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="TutorId"
                                                        Binding="{Binding TutorId}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="Date terminée"
                                                        Binding="{Binding CompletedDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION ÉLÈVE : NOTER LE TUTEUR -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,0,0,15"
                            Visibility="{Binding StudentSectionVisibility}">

                        <StackPanel>
                            <TextBlock Text="Noter mon tuteur"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="#273C75"/>

                            <TextBlock Text="Sélectionne une séance terminée, puis laisse une note et un commentaire."
                                       Foreground="Gray"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="Note /5 :"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60"
                                         Height="30"
                                         Margin="0,0,20,0"/>

                                <TextBlock Text="Commentaire :"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                         Width="350"
                                         Height="30"/>
                            </StackPanel>

                            <Button Content="Envoyer l'avis"
                                    Command="{Binding AddReviewCommand}"
                                    Width="160"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    Background="#3498DB"
                                    Foreground="White"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Chercher un tuteur"
                            Click="SearchTutor_Click"
                            Height="40"
                            Background="#3498DB"
                            Foreground="White"
                            FontWeight="Bold"
                            Visibility="{Binding StudentSectionVisibility}"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="DarkGreen"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- COLONNE DROITE -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>
                    <TextBlock Text="Informations personnelles"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="DA"
                               FontWeight="SemiBold"/>

                    <TextBox Text="{Binding DA}"
                             IsReadOnly="True"
                             Background="#F0F0F0"
                             Height="30"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Nom"
                               FontWeight="SemiBold"/>

                    <TextBox Text="{Binding Nom}"
                             Height="30"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Prénom"
                               FontWeight="SemiBold"/>

                    <TextBox Text="{Binding Prenom}"
                             Height="30"
                             Margin="0,5,0,10"/>

                    <StackPanel Visibility="{Binding TutorSectionVisibility}">
                        <TextBlock Text="Disponibilités"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>

                        <ComboBox ItemsSource="{Binding AvailabilityChoices}"
                                  SelectedItem="{Binding Availability}"
                                  Height="30"
                                  Margin="0,0,0,10"/>

                        <Button Content="Enregistrer"
                                Command="{Binding SaveAvailabilityCommand}"
                                Height="35"
                                Background="#3498DB"
                                Foreground="White"
                                FontWeight="Bold"/>

                        <TextBlock Text="Avis reçus"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,25,0,10"/>

                        <DataGrid ItemsSource="{Binding Reviews}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="220">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Note"
                                                    Binding="{Binding Rating}"
                                                    Width="60"/>

                                <DataGridTextColumn Header="Commentaire"
                                                    Binding="{Binding Comment}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </Border>
>>>>>>> Stashed changes
        </Grid>
    </Grid>
</Window>