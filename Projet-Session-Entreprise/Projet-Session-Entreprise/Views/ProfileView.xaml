<Window x:Class="Projet_Session_Entreprise.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Projet_Session_Entreprise.Views"
             Background="{DynamicResource MainBG}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Mon Profil" FontSize="36" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryMauve}"/>
            <Border Height="3" Background="{DynamicResource PrimaryMauve}" Width="60" HorizontalAlignment="Left" Margin="2,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="colDispos" Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,20,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Informations" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryMauve}" Margin="0,0,0,20"/>
                    <TextBlock Text="Numéro de DA" Foreground="{DynamicResource SubText}" FontSize="12"/>
                    <TextBlock Text="{Binding DA}" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                    <TextBlock Text="Prénom" Foreground="{DynamicResource SubText}" FontSize="12"/>
                    <TextBlock Text="{Binding Prenom}" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                    <TextBlock Text="Nom" Foreground="{DynamicResource SubText}" FontSize="12"/>
                    <TextBlock Text="{Binding Nom}" FontSize="18" Foreground="White" Margin="0,0,0,15"/>
                    <TextBlock Text="Rôle" Foreground="{DynamicResource SubText}" FontSize="12"/>
                    <Border Background="#2D2D2D" CornerRadius="5" HorizontalAlignment="Left" Padding="10,5">
                        <TextBlock Text="{Binding Role}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryMauve}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mes Rendez-vous" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryMauve}" Margin="0,0,0,20"/>
                    <DataGrid Grid.Row="1" x:Name="dgAppointments" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date et Heure" Binding="{Binding DateRDV, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/>
                            <DataGridTemplateColumn Header="Statut" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#333" CornerRadius="10" Padding="8,4">
                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ContentControl x:Name="AvailabilityContainer" Grid.Column="2" Visibility="Collapsed">
                <local:TutorAvailabilityControlView x:Name="ctrlAvailability"/>
            </ContentControl>
        </Grid>
    </Grid>
</Window>