<UserControl x:Class="Projet_Session_Entreprise.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Projet_Session_Entreprise.Views"
             Background="{StaticResource MainBG}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Mon Profil" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryMauve}"/>
            <Border Height="3" Background="{StaticResource PrimaryMauve}" Width="60" HorizontalAlignment="Left" Margin="2,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="colDispos" Width="350"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Informations" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,20"/>

                        <TextBlock Text="Numéro de DA" Foreground="{StaticResource SubText}" FontSize="12"/>
                        <TextBlock Text="{Binding DA}" FontSize="18" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="Prénom" Foreground="{StaticResource SubText}" FontSize="12"/>
                        <TextBlock Text="{Binding Prenom}" FontSize="18" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="Nom" Foreground="{StaticResource SubText}" FontSize="12"/>
                        <TextBlock Text="{Binding Nom}" FontSize="18" Foreground="White" Margin="0,0,0,15"/>

                        <Border Background="#2D2D2D" CornerRadius="5" HorizontalAlignment="Left" Padding="10,5">
                            <TextBlock Text="{Binding Role}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}"/>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="LightGreen" Margin="0,15,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Statistiques" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,15"/>
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="Séances" Foreground="{StaticResource SubText}" FontSize="12"/>
                                <TextBlock Text="{Binding TotalSeances}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Heures" Foreground="{StaticResource SubText}" FontSize="12"/>
                                <TextBlock Text="{Binding HeuresCompletees}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding TutorSectionVisibility}">
                                <TextBlock Text="Moyenne" Foreground="{StaticResource SubText}" FontSize="12"/>
                                <TextBlock Text="{Binding MoyenneStats}" FontSize="24" FontWeight="Bold" Foreground="#FFD700"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="AvailabilityContainer" Grid.Column="2" Visibility="{Binding TutorSectionVisibility}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Disponibilités" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryMauve}" Margin="0,0,0,10"/>
                        <local:TutorAvailabilityControlView x:Name="ctrlAvailability"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>